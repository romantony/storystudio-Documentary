# /etc/systemd/system/docgen.service on the instance: pull the current image and start the container at every boot.
[Unit]
Description=docgen container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/docgen
ExecStartPre=-/opt/docgen/fetch-env.sh
ExecStartPre=/bin/bash -c 'aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin $(grep ^DOCGEN_IMAGE_URI= .env | cut -d= -f2 | cut -d/ -f1)'
ExecStartPre=-/usr/bin/docker compose pull
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
[Install]
WantedBy=multi-user.target
