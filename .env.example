# Copy to /opt/docgen/.env on the instance (chmod 600). Never commit the real file, never bake it into the image.
DOCGEN_IMAGE_URI=<account>.dkr.ecr.us-east-1.amazonaws.com/docgen:latest
DOCGEN_API_TOKEN=            # bearer token the orchestrator sends
DOCGEN_CALLBACK_SECRET=      # HMAC secret shared with the orchestrator for webhooks
DOCGEN_ORIGIN_SECRET=        # value of the X-Origin-Verify header CloudFront adds to origin requests
VNC_PASSWORD=                # desktop password (max 8 characters are used by VNC)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
RUNPOD_API_KEY=
COMFY_API_KEY=
KIE_API_KEY=                 # cinematic thumbnails (Nano Banana 2.1 on KIE); without it the plain `thumb` thumbnail is made
DOCGEN_OUTPUT_BUCKET=        # S3 bucket (or R2 bucket with DOCGEN_S3_ENDPOINT) for finished files; the compose file has the default
DOCGEN_OUTPUT_BASE_URL=      # public address of that bucket (CDN), used to build the url of each output
DOCGEN_S3_ENDPOINT=
AWS_DEFAULT_REGION=us-east-1
